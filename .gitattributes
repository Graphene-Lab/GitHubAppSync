# Normalize line endings in the repository; check out as-is.
* text=auto eol=lf

# Windows scripts keep CRLF so they behave when double-clicked.
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text
*.zip    binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.nupkg  binary
